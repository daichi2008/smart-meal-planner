# App
APP_NAME=Smart Meal Planner
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite+aiosqlite:///./mealplanner.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mealplanner

# Redis (optional, falls back to in-memory cache)
REDIS_URL=

# LLM (OpenAI-compatible API)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_CACHE_AGE_HOURS=24

# AdvCash (Volet) SCI — الاشتراكات
# أنشئ SCI من حسابك في Volet/AdvCash (For developers > SCI) واملأ هذه القيم
ADVCASH_ACCOUNT_EMAIL=your-wallet@email.com
ADVCASH_SCI_NAME=your-sci-name
ADVCASH_SCI_PASSWORD=your-sci-secret-word
ADVCASH_CURRENCY=USD
ADVCASH_PLAN_PRICE_USD=6.00
ADVCASH_SUBSCRIPTION_DAYS=30

# Volet Payment Gateway Configuration
# احصل على بيانات الوصول من لوحة تحكم Volet
VOLET_MERCHANT_ID=your-merchant-id
VOLET_API_KEY=your-api-key
VOLET_SECRET_KEY=your-secret-key
VOLET_WEEKLY_PRICE_USD=2.00
VOLET_MONTHLY_PRICE_USD=7.00
VOLET_WEEKLY_SUBSCRIPTION_DAYS=7
VOLET_MONTHLY_SUBSCRIPTION_DAYS=30

# Frontend / Backend
FRONTEND_URL=http://localhost:3000
# عنوان الخادم العام (مطلوب لكي يصل إشعار الدفع من AdvCash إلى الخادم)
BACKEND_URL=http://localhost:8000
# CORS_ORIGINS: optional JSON list, e.g. ["http://localhost:3000","https://site.com"]. Empty in dev = allow all.

# CORS
BACKEND_PORT=8000
