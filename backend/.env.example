# App
APP_NAME=Smart Meal Planner
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite+aiosqlite:///./mealplanner.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mealplanner

# Redis (optional, falls back to in-memory cache)
REDIS_URL=

# LLM (OpenAI-compatible API)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_CACHE_AGE_HOURS=24

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_CURRENCY=usd

# Frontend
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS: optional JSON list, e.g. ["http://localhost:3000","https://site.com"]. Empty in dev = allow all.

# CORS
BACKEND_PORT=8000
